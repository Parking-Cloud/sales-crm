{
  "name": "sales-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "users:sync": "npm run scripts:build && node scripts/dist/sync-allowed-users.js",
    "scripts:build": "tsc -p scripts/tsconfig.json",
    "db:migrate": "npm run scripts:build && node scripts/dist/apply-migrations.js",
    "db:test": "npm run scripts:build && node scripts/dist/run-db-tests.js",
    "google:check-types": "tsc -p tsconfig.test.json && npm run scripts:build && node scripts/dist/check-place-types.js",
    "test:unit": "tsc -p tsconfig.test.json && node --test .test-dist/tests/unit/import.test.js .test-dist/tests/unit/places.test.js .test-dist/tests/unit/maps-link.test.js .test-dist/tests/unit/pipeline.test.js .test-dist/tests/unit/email.test.js .test-dist/tests/unit/cadences.test.js .test-dist/tests/unit/export.test.js .test-dist/tests/unit/tables.test.js .test-dist/tests/unit/analytics.test.js",
    "test:fixtures": "node tests/fixtures/build-crm-2026-fixture.mjs && tsc -p tsconfig.test.json && node .test-dist/tests/fixtures/build-import-plan.js"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "exceljs": "4.4.0",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "supabase": "2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
